# --- Three values. That is all a deployment needs ----------------------------
# On Cloudflare these go in Settings → Variables and Secrets.
DOMAIN=["example.com","example2.com"]
ADMIN=root@example.com
jwt_secret=anyRandomLettersAndDigits

# --- Not required ------------------------------------------------------------
# HENNA_CREDENTIAL_KEY is derived from jwt_secret by HKDF when absent. Set it
# only if you want the two secrets to rotate independently.
# HENNA_CREDENTIAL_KEY=base64-of-32-random-bytes

# --- Self-hosted Node.js only ------------------------------------------------
DATABASE_URL=postgresql://henna:henna@localhost:5432/henna
AUTH_URL=http://localhost:3000
AUTH_SECRET=a-long-random-string-for-authjs

# --- Everything below is configured in /admin/settings -----------------------
# GitHub OAuth, Resend, object storage, TOTP policy, registration mode.
# Listing them here is only a shortcut for local development.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# RESEND_API_KEY=
# HENNA_EMAIL_FROM=Henna <no-reply@example.com>

# --- Object storage build-time caveat ----------------------------------------
# If you configure storage ONLY in /admin/settings, the bucket origin must also
# be known at build time or the CSP will block the browser:
# HENNA_R2_ACCOUNT_ID=0123456789abcdef0123456789abcdef
# HENNA_STORAGE_ORIGINS=https://<account>.r2.cloudflarestorage.com
